      </style>
      <size maxheight='964' maxwidth='1016' minheight='964' minwidth='1016' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98340' id='1' param='vert' removable='false' type-v2='layout-flow' w='98426' x='787' y='830'>
            <zone h='3423' id='3' type-v2='title' w='98426' x='787' y='830' />
            <zone fixed-size='112' h='11618' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='98426' x='787' y='4253' />
            <zone h='83299' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98426' x='787' y='15871'>
              <flipboard active-id='9' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='Distribusi produk di Negara brazil tergolong merata dengan Sao Paulo yang memiliki kontribusi terbanyak' captured-sheet='Top States' id='1'>
                    <capturedDeltas>
                      <worksheet name='Top States'>
                        <style delta-type='added'>
                          <style-rule element='axis'>
                            <encoding attr='space' class='0' field='[federated.03m56cd1unkf180zoet7000ny26o].[Latitude (generated)]' field-type='quantitative' max='251408.66814097157' min='-4437310.6176743843' projection='EPSG:3857' range-type='fixed' scope='rows' type='space' />
                            <encoding attr='space' class='0' field='[federated.03m56cd1unkf180zoet7000ny26o].[Longitude (generated)]' field-type='quantitative' max='-3854818.2757031345' min='-8696494.4063515309' projection='EPSG:3857' range-type='fixed' scope='cols' type='space' />
                          </style-rule>
                        </style>
                      </worksheet>
                    </capturedDeltas>
                  </story-point>
                  <story-point caption='Sebanyak 94.854 pesanan berstatus shipped yang menunjukkan keberhasilan proses transaksi' captured-sheet='Order Status' id='2' />
                  <story-point caption='Sao Paulo menjadi penyumbang kontribusi terhadap keuntungan perusahaan terbesar di Brazil' captured-sheet='Top 5 States by Orders' id='5' />
                  <story-point caption='Terdapat penurunan tidak wajar di grafik pada bulan september 2018, hal ini harus segera diatasi karena perusahaan tergambarkan tidak memiliki keuntungan sedikitpun di periode tersebut ' captured-sheet='Sales Trend' id='4' />
                  <story-point caption='Trend perusahaan tergolong sehat dengan trend yang selalu naik walaupun terdapat penurunan, meski begitu perusahaan dapat mengatasi hal tersebut' captured-sheet='Sales Trend' id='6'>
                    <capturedDeltas>
                      <worksheet name='Sales Trend'>
                        <selection-collection>
                          <node-selection select-tuples='false'>
                            <oriented-node-reference orientation='vertical'>
                              <node-reference>
                                <axis>[federated.03m56cd1unkf180zoet7000ny26o].[__tableau_internal_object_id__].[cnt:Order!Payments_F80399F9CA85411A9874D97EBB6932AC:qk]</axis>
                              </node-reference>
                              <page-reference />
                            </oriented-node-reference>
                          </node-selection>
                        </selection-collection>
                      </worksheet>
                    </capturedDeltas>
                  </story-point>
                  <story-point caption='Metode pembayaran menggunakan debit card menjadi metode favorit bagi para pengguna' captured-sheet='Proportion of Payment Method' id='7' />
                  <story-point caption='Metode pembayaran menggunakan debit card menjadi metode favorit bagi para pengguna' captured-sheet='Proportion of Payment Method' id='8' />
                  <story-point caption='Valuasi transaksi sangat baik dengan jumlah pendapatan sebanyak 8.559.152 ditahun 2018 dan 7.022.919 ditahun 2017' captured-sheet='Transcation Value by Year' id='9' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
          <zone-style>
